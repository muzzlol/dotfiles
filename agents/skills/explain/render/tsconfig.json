{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "paths": {
      "explain": [
        "./src/index.ts"
      ],
      "explain-engine": [
        "./src/engine-elk.ts"
      ]
    }
  },
  "include": [
    "src",
    "*.ts",
    "test"
  ]
}
